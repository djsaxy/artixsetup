# === App Binds ===

# Terminal 
super + Return
    st

# App Launcher
super + space
    rofi -show drun -show-icons

# Browser
super + b
    helium-browser

# Incognito Browser
super + shift + b
    helium-browser --incognito

# File Manager
super + e
    nautilus


# === Window Binds ===

# Quit current window
super + q
    bspc node -c

# Switch window focus
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Interchange windows
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Toggle floating
super + shift + f
    bspc node -t ~floating

# Toggle fullscreen
super + f
    bspc node -t ~fullscreen


# === Media & Brightness ===

# Volume Up
XF86AudioRaiseVolume
    amixer set Master 5%+

# Volume Down
XF86AudioLowerVolume
    amixer set Master 5%-

# Mute/Unmute Volume
XF86AudioMute
    amixer set Master toggle

# Increase Screen Brightness
XF86MonBrightnessUp
    brightnessctl set +5%

# Decrease Screen Brightness
XF86MonBrightnessDown
    brightnessctl set 5%-


# === Workspace binds ===

# Switch between workspaces
super + {1-9,0}
    bspc desktop -f {1-9,10}

# Shift windows to different workspaces
super + shift + {1-9,0}
    bspc node -d {1-9,10}


# === Session Binds ===

# Screen lock & Suspend
super + s
    slock loginctl suspend -i

# Screen lock without Suspend
super + shift + s
    slock

# Reload sxhkd
super + Escape
    pkill -USR1 -x sxhkd

# Reload bspwm
super + shift + r
    bspc wm -r

# Quit bspwm
super + shift + q
    bspc quit
